#!/usr/bin/env python3
"""Make the pinned CLI's docker create -p bindings explicit on Docker Desktop."""
import os
import re
import sys

args = sys.argv[1:]
if "create" in args or "run" in args:
    if "--name" in args and args[args.index("--name") + 1] == "supabase_kong_" + os.environ["SVML_STACK_ID"]:
        # Kong's default combined format includes the original query and Referer.
        # Keep route, method, status and latency for operational monitoring.
        pos = args.index("--name")
        args[pos:pos] = ["--env", "KONG_NGINX_HTTP_LOG_FORMAT=svml '$request_method $uri $status $request_time'",
                         "--env", "KONG_PROXY_ACCESS_LOG=/dev/stdout svml",
                         "--label", "svml.auth-log-format=path-v1"]
    for index, arg in enumerate(args):
        if arg in ("-p", "--publish"):
            binding = args[index + 1]
            if not re.fullmatch(r"[0-9]+:[0-9]+(?:/tcp|/udp)?", binding):
                sys.exit("Unexpected port mapping in local Google stack")
            args[index + 1] = "127.0.0.1:" + binding

docker = os.environ["SVML_DOCKER_BINARY"]
os.execv(docker, [docker, *args])
