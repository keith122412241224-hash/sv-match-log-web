{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SV Match Log 総合環境評価入力 v1",
  "description": "項目検証に加え、利用時は保存済みスナップショットと validateEvaluation による照合が必須。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "environmentId": {
      "$ref": "#/$defs/id"
    },
    "snapshotId": {
      "$ref": "#/$defs/id"
    },
    "public": {
      "type": "object",
      "properties": {
        "overview": {
          "type": "object",
          "properties": {
            "facts": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200,
              "pattern": "^(?![\\s\\S]*(?:[Hh][Tt][Tt][Pp][Ss]?://|[Ww][Ww][Ww]\\.|</?[A-Za-z][^>]*>))[\\s\\S]*$"
            },
            "hypothesis": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1200,
              "pattern": "^(?![\\s\\S]*(?:[Hh][Tt][Tt][Pp][Ss]?://|[Ww][Ww][Ww]\\.|</?[A-Za-z][^>]*>))[\\s\\S]*$"
            }
          },
          "required": [
            "facts",
            "hypothesis"
          ],
          "additionalProperties": false
        },
        "comparison": {
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        },
        "decks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deck"
          }
        },
        "pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pair"
          }
        },
        "changes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "^(?![\\s\\S]*(?:[Hh][Tt][Tt][Pp][Ss]?://|[Ww][Ww][Ww]\\.|</?[A-Za-z][^>]*>))[\\s\\S]*$"
        }
      },
      "required": [
        "overview",
        "comparison",
        "decks",
        "pairs",
        "changes"
      ],
      "additionalProperties": false
    },
    "internal": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "maxItems": 100
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "limitations": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1800
        }
      },
      "required": [
        "sources",
        "evidence",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "environmentId",
    "snapshotId",
    "public",
    "internal"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "divergence": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "確認済み",
            "要検証"
          ]
        },
        "direction": {
          "enum": [
            "過小評価の可能性",
            "過大評価の可能性",
            "評価が分かれている",
            "判断保留"
          ]
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "facts": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "^(?![\\s\\S]*(?:[Hh][Tt][Tt][Pp][Ss]?://|[Ww][Ww][Ww]\\.|</?[A-Za-z][^>]*>))[\\s\\S]*$"
        },
        "hypothesis": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1200,
          "pattern": "^(?![\\s\\S]*(?:[Hh][Tt][Tt][Pp][Ss]?://|[Ww][Ww][Ww]\\.|</?[A-Za-z][^>]*>))[\\s\\S]*$"
        }
      },
      "required": [
        "status",
        "direction",
        "importance",
        "facts",
        "hypothesis"
      ],
      "additionalProperties": false
    },
    "deck": {
      "type": "object",
      "properties": {
        "deckId": {
          "$ref": "#/$defs/id"
        },
        "tier": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "^(?![\\s\\S]*(?:[Hh][Tt][Tt][Pp][Ss]?://|[Ww][Ww][Ww]\\.|</?[A-Za-z][^>]*>))[\\s\\S]*$"
        },
        "confidence": {
          "enum": [
            "高",
            "中",
            "低",
            "判断保留"
          ]
        },
        "divergence": {
          "anyOf": [
            {
              "$ref": "#/$defs/divergence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "deckId",
        "tier",
        "reason",
        "confidence",
        "divergence"
      ],
      "additionalProperties": false
    },
    "pair": {
      "type": "object",
      "properties": {
        "a": {
          "$ref": "#/$defs/id"
        },
        "b": {
          "$ref": "#/$defs/id"
        },
        "rating": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -2,
              "maximum": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "^(?![\\s\\S]*(?:[Hh][Tt][Tt][Pp][Ss]?://|[Ww][Ww][Ww]\\.|</?[A-Za-z][^>]*>))[\\s\\S]*$"
        },
        "confidence": {
          "enum": [
            "高",
            "中",
            "低",
            "判断保留"
          ]
        },
        "divergence": {
          "anyOf": [
            {
              "$ref": "#/$defs/divergence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "a",
        "b",
        "rating",
        "reason",
        "confidence",
        "divergence"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https?://"
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrievedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "environmentId": {
          "$ref": "#/$defs/id"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "trend": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reliability": {
          "enum": [
            "高",
            "中",
            "低"
          ]
        }
      },
      "required": [
        "id",
        "url",
        "publisher",
        "group",
        "publishedAt",
        "retrievedAt",
        "environmentId",
        "summary",
        "trend",
        "reliability"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 257
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "externalTrend": {
          "enum": [
            "上振れ評価",
            "下振れ評価",
            "評価分裂",
            "概ね一致",
            "比較不能"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "facts": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "hypothesis": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1200
        }
      },
      "required": [
        "target",
        "sourceIds",
        "externalTrend",
        "rationale",
        "facts",
        "hypothesis"
      ],
      "additionalProperties": false
    }
  }
}
